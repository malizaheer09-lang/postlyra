# Copy this file to .env and fill in real values before running in production.

# Port the server listens on
PORT=3000

# Used to sign session tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# "development" or "production". In production, cookies are sent with Secure
# flag, which requires HTTPS.
NODE_ENV=development

# Used to generate AI captions/hashtags for uploaded photos, via Google's
# Gemini API (free tier). Get one at aistudio.google.com -> "Get API key"
# -> Create API key. No credit card needed for the free tier. Without this,
# uploads still work — captions just show a placeholder telling you to add
# a key, until you do.
#
# Two things worth knowing about the free tier before relying on it for
# real customers: rate limits are tight and change often, and Google's
# free-tier terms exclude commercial use (see ai.google.dev/gemini-api/terms).
GEMINI_API_KEY=

# ── Social publishing ────────────────────────────────────────────────────────
# Leave these blank to run in DEMO MODE (fake connections, no real posting).
# Fill them in once you have real credentials from each platform's dev portal.

# Meta (covers Facebook Pages + Instagram Business accounts)
# Get from: developers.facebook.com → Your App → App Settings → Basic
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Google (covers YouTube channels + Google Business Profiles)
# Get from: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# The public URL of your server. Change this when deploying to a real domain.
# Must match the redirect URIs you registered in each platform's dev console.
BASE_URL=http://localhost:3000
